{% assign project_href = project.url | relative_url %}
{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% endif %}

<li class="projects-list-item">
  <div class="row project-entry-row">
    <div class="col-sm-2 project-preview">
      {% if project.img %}
        {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 170px, 90vw" alt="project thumbnail" class="project-thumb" %}
      {% else %}
        <div class="project-thumb-placeholder" aria-hidden="true">
          <i class="fa-regular fa-image"></i>
        </div>
      {% endif %}
    </div>
    <div class="col-sm-10 project-content">
      <div class="title-row">
        <div class="title">
          <a class="project-title-link" href="{{ project_href }}">{{ project.title }}</a>
        </div>
        {% if project.year %}
          <div class="pub-year">{{ project.year }}</div>
        {% endif %}
      </div>
      <p class="project-description">{{ project.description }}</p>
      <div class="links project-links">
        <a href="{{ project_href }}" class="btn btn-sm z-depth-0" role="button">Details</a>
        {% if project.github %}
          <a href="{{ project.github }}" class="btn btn-sm z-depth-0" role="button">GitHub</a>
        {% endif %}
        {% if project.github_stars %}
          <span class="project-stars" data-toggle="tooltip" title="GitHub Stars">
            <i class="fa-solid fa-star"></i>
            <span id="{{ project.github_stars }}-stars"></span>
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</li>
